// Telegram Archive Manager — PostgreSQL 18 schema (Prisma 7).
//
// Conventions
// - Primary keys: uuid v7 generated by PostgreSQL 18 (`uuidv7()`), so raw SQL inserts get ids too.
// - Telegram ids: chat ids / access hashes / grouped ids / sizes are BIGINT; message ids are INT
//   (MTProto server message ids are int32). The API serializes BIGINT as strings.
// - Every index is declared here (including GIN, trigram and partial indexes) so that
//   `prisma migrate dev` never drops them. Hand-written SQL in migrations is limited to
//   extensions, the `tam_simple` text search configuration, the search_vector triggers, the
//   change-notification triggers (pg_notify on channel `tam_changes`, read by the api for SSE),
//   the triggers that fill download_jobs.channel_id/size from the file, and the check that a
//   Telegram backup chat is never the default download location.
// - Binary media never lives in PostgreSQL; `media.storage_key` points into object storage.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
  previewFeatures     = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

enum ChatType {
  CHANNEL
  SUPERGROUP
  GROUP
}

enum MessageType {
  TEXT
  PHOTO
  VIDEO
  DOCUMENT
  AUDIO
  VOICE
  ANIMATION
  VIDEO_NOTE
  STICKER
  POLL
  WEBPAGE
  SERVICE
  OTHER
}

enum MediaType {
  PHOTO
  VIDEO
  DOCUMENT
  AUDIO
  VOICE
  ANIMATION
  VIDEO_NOTE
  STICKER
}

enum DownloadStatus {
  PENDING
  DOWNLOADING
  DOWNLOADED
  FAILED
  SKIPPED
  CANCELLED
}

enum DownloadJobStatus {
  PENDING
  ACTIVE
  PAUSED
  COMPLETED
  FAILED
  SKIPPED
  CANCELLED
}

/// Why a file is not downloaded (with status SKIPPED).
enum DownloadSkipReason {
  /// Outside the automatic download settings; downloads when requested.
  POLICY
  /// The message was deleted on Telegram, or its file was replaced.
  NOT_AVAILABLE
  /// Content protection was turned on for the chat.
  PROTECTED
}

/// What a running download does right now.
enum DownloadStage {
  FETCHING
  VERIFYING
  STORING
}

enum JobStatus {
  PENDING
  RUNNING
  PAUSED
  COMPLETED
  FAILED
  CANCELLED
}

enum ImportJobType {
  IMPORT
  SYNC
}

/// Why a job runs: someone asked for it, the scheduled check found new messages, or Telegram
/// announced new messages.
enum JobOrigin {
  MANUAL
  SCHEDULE
  TELEGRAM_UPDATE
}

enum ImportMode {
  ALL
  FROM_DATE
}

enum ImportJobPhase {
  HISTORY
  MEDIA
  DONE
}

enum TelegramAuthState {
  LOGGED_OUT
  CODE_SENT
  PASSWORD_REQUIRED
  READY
}

enum StorageKind {
  LOCAL
  GOOGLE_DRIVE
  /// A Telegram chat (channel or forum supergroup) that receives backup copies of messages.
  /// Never a download location, never the default.
  TELEGRAM
}

/// Where the backup copy of a message stands in one backup chat.
enum BackupStatus {
  PENDING
  ACTIVE
  COMPLETED
  FAILED
  SKIPPED
}

/// What a running backup does right now.
enum BackupStage {
  /// Reading the source message and opening its file.
  FETCHING
  /// Streaming the file from its source into an upload to the backup chat.
  UPLOADING
  /// The send is under way: after a crash, the backup chat is read before anything is sent again.
  SENDING
}

/// Why a message is not backed up (with status SKIPPED).
enum BackupSkipReason {
  /// The source message or its file is gone and no downloaded copy exists.
  NOT_AVAILABLE
  /// Content protection was turned on for the source chat.
  PROTECTED
  /// A kind of message that cannot be recreated (poll, location, service message…).
  UNSUPPORTED
  /// Larger than Telegram accepts from this account (2000 MiB, or 4000 MiB with Premium).
  TOO_LARGE
}

// ---------------------------------------------------------------------------
// Web authentication
// ---------------------------------------------------------------------------

model User {
  id           String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// Stored lower-cased by the application.
  email        String    @unique
  passwordHash String    @map("password_hash")
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions Session[]

  @@map("users")
}

model Session {
  id                String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  /// sha256(token) as lowercase hex; the raw token only ever lives in the cookie.
  tokenHash         String   @unique @map("token_hash") @db.Char(64)
  /// Sliding expiry, extended at most every few minutes.
  expiresAt         DateTime @map("expires_at") @db.Timestamptz(3)
  absoluteExpiresAt DateTime @map("absolute_expires_at") @db.Timestamptz(3)
  lastSeenAt        DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  userAgent         String?  @map("user_agent")
  ip                String?
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// ---------------------------------------------------------------------------
// Telegram account & dialog cache (written by the worker only)
// ---------------------------------------------------------------------------

model TelegramAccount {
  id                 String            @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// Single-tenant: one row with accountKey = 'default'.
  accountKey         String            @unique @default("default") @map("account_key")
  telegramUserId     BigInt?           @map("telegram_user_id")
  username           String?
  displayName        String?           @map("display_name")
  /// AES-256-GCM encrypted phone number (worker key).
  phoneEnc           Bytes?            @map("phone_enc")
  phoneMasked        String?           @map("phone_masked")
  authState          TelegramAuthState @default(LOGGED_OUT) @map("auth_state")
  /// AES-256-GCM encrypted phone_code_hash of the pending login.
  phoneCodeHashEnc   Bytes?            @map("phone_code_hash_enc")
  /// The pending login is abandoned after this moment.
  codeExpiresAt      DateTime?         @map("code_expires_at") @db.Timestamptz(3)
  /// How the pending code was delivered (app, sms, call, …).
  codeType           String?           @map("code_type")
  nextCodeType       String?           @map("next_code_type")
  /// Telegram allows requesting another code from this moment.
  codeResendAt       DateTime?         @map("code_resend_at") @db.Timestamptz(3)
  lastError          String?           @map("last_error")
  /// Last completed refresh of telegram_dialogs.
  dialogsRefreshedAt DateTime?         @map("dialogs_refreshed_at") @db.Timestamptz(3)
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("telegram_accounts")
}

/// Cache of the dialogs the account can access. POST /api/channels copies from here,
/// so clients can never supply title/access_hash/is_protected themselves.
model TelegramDialog {
  id                 String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// Marked id (-100… for channels/supergroups, -id for basic groups).
  telegramChatId     BigInt   @unique @map("telegram_chat_id")
  title              String
  username           String?
  type               ChatType
  accessHash         BigInt?  @map("access_hash")
  isForum            Boolean  @default(false) @map("is_forum")
  isProtected        Boolean  @default(false) @map("is_protected")
  memberCount        Int?     @map("member_count")
  migratedFromChatId BigInt?  @map("migrated_from_chat_id")
  /// The account may post messages here (owner, or admin allowed to post): a possible backup chat.
  canPost            Boolean  @default(false) @map("can_post")
  /// The account may create forum topics here (needed to back up a forum into it).
  canManageTopics    Boolean  @default(false) @map("can_manage_topics")
  lastSeenAt         DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(3)

  @@map("telegram_dialogs")
}

// ---------------------------------------------------------------------------
// Storage locations (where downloaded media is written)
// ---------------------------------------------------------------------------

/// A folder on the server or in a Google Drive (download locations), or a Telegram chat that
/// receives backup copies (kind TELEGRAM). Channels choose one download location and optionally
/// one backup chat; each media row remembers the location its file was written to, so changing
/// a channel's location never loses files.
model StorageLocation {
  id               String      @id @default(dbgenerated("uuidv7()")) @db.Uuid
  kind             StorageKind
  name             String
  /// Where files go, for people: an absolute folder, "My Drive › <folder>" or "Telegram › <chat>".
  displayPath      String      @map("display_path")
  /// Identity of the target: the folder path (case-folded on Windows), the Drive folder id, or
  /// the Telegram chat's marked id.
  target           String
  /// Non-secret settings: { path }, { folderId, folderName, accountEmail } or
  /// { chatId, title, username, type, isForum }.
  config           Json
  /// AES-256-GCM sealed credentials (Google refresh token, STORAGE_SECRET_KEY); api/worker only.
  secretEnc        Bytes?      @map("secret_enc")
  /// Used by channels that did not choose a location. At most one.
  isDefault        Boolean     @default(false) @map("is_default")
  /// The location that follows STORAGE_LOCAL_ROOT; kept in step by the api at startup.
  builtIn          Boolean     @default(false) @map("built_in")
  /// Outcome of the last check (probe); null when it worked.
  lastError        String?     @map("last_error")
  lastCheckedAt    DateTime?   @map("last_checked_at") @db.Timestamptz(3)
  /// Downloads to this location wait until then (disk full, Drive rate limit, access lost);
  /// last_error says why. A successful check or a reconnect clears it.
  unavailableUntil DateTime?   @map("unavailable_until") @db.Timestamptz(3)
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  channels       Channel[]       @relation("ChannelStorageLocation")
  backupChannels Channel[]       @relation("ChannelBackupLocation")
  media          Media[]
  messageBackups MessageBackup[]
  backupTopics   BackupTopic[]

  @@unique([kind, target])
  @@unique([isDefault], map: "storage_locations_one_default", where: raw("is_default"))
  @@unique([builtIn], map: "storage_locations_one_built_in", where: raw("built_in"))
  @@map("storage_locations")
}

// ---------------------------------------------------------------------------
// Archive
// ---------------------------------------------------------------------------

model Channel {
  id                  String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  telegramChatId      BigInt    @unique @map("telegram_chat_id")
  title               String
  username            String?
  type                ChatType
  accessHash          BigInt?   @map("access_hash")
  isForum             Boolean   @default(false) @map("is_forum")
  isProtected         Boolean   @default(false) @map("is_protected")
  memberCount         Int?      @map("member_count")
  /// Keep the channel up to date: the worker reads new messages on a schedule and when Telegram
  /// announces them.
  syncEnabled         Boolean   @default(true) @map("sync_enabled")
  /// Why automatic sync switched itself off (e.g. content protection was turned on).
  syncNote            String?   @map("sync_note")
  /// Newest message id of the contiguous imported range [backfillCursorId … headMessageId].
  headMessageId       Int?      @map("head_message_id")
  /// Oldest message id of the contiguous imported range (backfill resumes below it).
  backfillCursorId    Int?      @map("backfill_cursor_id")
  backfillComplete    Boolean   @default(false) @map("backfill_complete")
  lastSyncedAt        DateTime? @map("last_synced_at") @db.Timestamptz(3)
  /// Set on a supergroup that was upgraded from a basic group.
  migratedFromChatId  BigInt?   @map("migrated_from_chat_id")
  /// Set on the legacy basic-group row; points at the supergroup row.
  migratedToChannelId String?   @map("migrated_to_channel_id") @db.Uuid
  /// Where new media of this channel is written; null = the default location.
  storageLocationId   String?   @map("storage_location_id") @db.Uuid
  /// The channel's folder inside its location ("Title (chat id)"), fixed once chosen.
  storageFolder       String?   @map("storage_folder")
  /// Download media automatically (within the download settings). Channels archived before
  /// downloads existed start with it off.
  downloadMedia       Boolean   @default(true) @map("download_media")
  /// Why automatic downloads stopped by themselves (e.g. the chat can no longer be read).
  downloadNote        String?   @map("download_note")
  /// When the worker last read the forum topics from Telegram (forums only).
  topicsRefreshedAt   DateTime? @map("topics_refreshed_at") @db.Timestamptz(3)
  /// The Telegram chat (a storage location of kind TELEGRAM) that receives backup copies of
  /// this channel's messages.
  backupLocationId    String?   @map("backup_location_id") @db.Uuid
  /// Back up every message automatically, new ones included. Off by default; "Back up now"
  /// works for single messages while it is off, as long as a backup chat is chosen.
  backupEnabled       Boolean   @default(false) @map("backup_enabled")
  /// Why backups stopped by themselves (content protection, the backup chat refused posts…).
  backupNote          String?   @map("backup_note")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  migratedTo      Channel?         @relation("ChannelMigration", fields: [migratedToChannelId], references: [id], onDelete: SetNull)
  migratedFrom    Channel[]        @relation("ChannelMigration")
  storageLocation StorageLocation? @relation("ChannelStorageLocation", fields: [storageLocationId], references: [id], onDelete: Restrict)
  backupLocation  StorageLocation? @relation("ChannelBackupLocation", fields: [backupLocationId], references: [id], onDelete: Restrict)
  messages        Message[]
  importJobs      ImportJob[]
  forumTopics     ForumTopic[]
  messageBackups  MessageBackup[]
  backupTopics    BackupTopic[]

  @@index([migratedToChannelId])
  @@index([storageLocationId])
  @@index([backupLocationId])
  @@map("channels")
}

model Message {
  id                String                   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  channelId         String                   @map("channel_id") @db.Uuid
  telegramMessageId Int                      @map("telegram_message_id")
  type              MessageType
  /// Message text when the message has no media.
  text              String?
  /// Message text when the message has media (MTProto stores both in one field).
  caption           String?
  /// Formatting entities of whichever of text/caption is set.
  entities          Json?
  telegramDate      DateTime                 @map("telegram_date") @db.Timestamptz(3)
  editDate          DateTime?                @map("edit_date") @db.Timestamptz(3)
  replyToMessageId  Int?                     @map("reply_to_message_id")
  /// Album id (grouped_id).
  mediaGroupId      BigInt?                  @map("media_group_id")
  /// Forum topic / thread id.
  threadId          Int?                     @map("thread_id")
  forwardInfo       Json?                    @map("forward_info")
  views             Int?
  /// Original Telegram message info shown in the detail page (post author, forwards, …).
  telegramMeta      Json?                    @map("telegram_meta")
  isFavorite        Boolean                  @default(false) @map("is_favorite")
  favoritedAt       DateTime?                @map("favorited_at") @db.Timestamptz(3)
  /// Text (weight A), caption (B) and the names of the message's files (A); maintained by the
  /// messages_search_vector_trg and media_search_vector_trg triggers (see migrations).
  searchVector      Unsupported("tsvector")? @map("search_vector")
  createdAt         DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  channel Channel         @relation(fields: [channelId], references: [id], onDelete: Cascade)
  media   Media[]
  tags    MessageTag[]
  backups MessageBackup[]

  @@unique([channelId, telegramMessageId])
  @@index([channelId, telegramDate(sort: Desc), telegramMessageId(sort: Desc)])
  @@index([telegramDate(sort: Desc), telegramMessageId(sort: Desc)])
  /// Lists of one category (Videos, Documents…) across channels.
  @@index([type, telegramDate(sort: Desc), telegramMessageId(sort: Desc)])
  /// A forum topic's messages in order, and the counts per topic.
  @@index([channelId, threadId, telegramDate, telegramMessageId])
  @@index([channelId, mediaGroupId])
  @@index([favoritedAt(sort: Desc)], map: "messages_favorites_idx", where: raw("is_favorite"))
  @@index([searchVector], map: "messages_search_vector_idx", type: Gin)
  @@map("messages")
}

model Media {
  id                   String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  messageId            String         @map("message_id") @db.Uuid
  /// Opaque adapter id `chatId:messageId:fileUniqueId` — never a raw (expiring) file_reference.
  telegramFileId       String         @map("telegram_file_id")
  /// Stable Telegram file identity; used to never download the same file twice.
  telegramFileUniqueId String         @map("telegram_file_unique_id")
  type                 MediaType
  filename             String?
  mimeType             String?        @map("mime_type")
  size                 BigInt?
  width                Int?
  height               Int?
  /// Seconds.
  duration             Float?
  /// The location holding the stored object; set when the download completes.
  storageLocationId    String?        @map("storage_location_id") @db.Uuid
  /// Readable path inside that location (see @tam/storage paths.ts).
  storageKey           String?        @map("storage_key")
  /// Key of the Telegram thumbnail in the local thumbnail cache (THUMBNAIL_DIR).
  thumbnailKey         String?        @map("thumbnail_key")
  /// When the thumbnail was looked for; null = not yet (thumbnail_key stays null when there is none).
  thumbnailCheckedAt   DateTime?      @map("thumbnail_checked_at") @db.Timestamptz(3)
  downloadStatus       DownloadStatus @default(PENDING) @map("download_status")
  /// 0–100.
  downloadProgress     Int            @default(0) @map("download_progress")
  downloadedBytes      BigInt         @default(0) @map("downloaded_bytes")
  /// SHA-256 of the stored object (lowercase hex).
  checksum             String?        @db.Char(64)
  error                String?
  createdAt            DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  message         Message          @relation(fields: [messageId], references: [id], onDelete: Cascade)
  storageLocation StorageLocation? @relation(fields: [storageLocationId], references: [id], onDelete: Restrict)
  downloadJob     DownloadJob?

  @@unique([messageId, telegramFileUniqueId])
  /// Two files never share a path inside one location.
  @@unique([storageLocationId, storageKey])
  @@index([telegramFileUniqueId])
  @@index([checksum])
  @@index([downloadStatus, type])
  @@index([filename(ops: raw("gin_trgm_ops"))], map: "media_filename_trgm_idx", type: Gin)
  @@index([id], map: "media_thumbnail_pending_idx", where: raw("(thumbnail_checked_at IS NULL)"))
  @@map("media")
}

/// A topic of a forum supergroup, as Telegram describes it (read by the worker). Messages point at
/// their topic through messages.thread_id, except those of the General topic (id 1): null there.
model ForumTopic {
  id           String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  channelId    String    @map("channel_id") @db.Uuid
  /// Telegram topic id: the id of the service message that created the topic (1 = General).
  topicId      Int       @map("topic_id")
  title        String
  /// RGB colour of the topic icon.
  iconColor    Int?      @map("icon_color")
  isClosed     Boolean   @default(false) @map("is_closed")
  isPinned     Boolean   @default(false) @map("is_pinned")
  isHidden     Boolean   @default(false) @map("is_hidden")
  /// When the topic was created on Telegram.
  telegramDate DateTime? @map("telegram_date") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([channelId, topicId])
  @@map("forum_topics")
}

model Tag {
  id             String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name           String
  /// NFC + lower-case form of name; enforces case/Unicode-insensitive uniqueness.
  nameNormalized String   @unique @map("name_normalized")
  /// Hex colour, e.g. #3f51b5.
  color          String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  messages MessageTag[]

  @@map("tags")
}

model MessageTag {
  messageId String   @map("message_id") @db.Uuid
  tagId     String   @map("tag_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([messageId, tagId])
  @@index([tagId])
  @@map("message_tags")
}

// ---------------------------------------------------------------------------
// Jobs (PostgreSQL is the source of truth; BullMQ is transport only)
// ---------------------------------------------------------------------------

model ImportJob {
  id                  String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  channelId           String         @map("channel_id") @db.Uuid
  /// Child jobs import the legacy basic group of a migrated supergroup.
  parentImportJobId   String?        @map("parent_import_job_id") @db.Uuid
  type                ImportJobType  @default(IMPORT)
  origin              JobOrigin      @default(MANUAL)
  mode                ImportMode     @default(ALL)
  fromDate            DateTime?      @map("from_date") @db.Timestamptz(3)
  status              JobStatus      @default(PENDING)
  phase               ImportJobPhase @default(HISTORY)
  /// Incremented on every (re)enqueue; BullMQ job id = ij-<id>-<runSeq>.
  runSeq              Int            @default(0) @map("run_seq")
  bullJobId           String?        @map("bull_job_id")
  totalMessages       Int?           @map("total_messages")
  processedMessages   Int            @default(0) @map("processed_messages")
  // The counters below are a cache recomputed from download_jobs aggregates — never incremented.
  totalMedia          Int            @default(0) @map("total_media")
  downloadedFiles     Int            @default(0) @map("downloaded_files")
  failedFiles         Int            @default(0) @map("failed_files")
  skippedFiles        Int            @default(0) @map("skipped_files")
  totalBytes          BigInt         @default(0) @map("total_bytes")
  downloadedBytes     BigInt         @default(0) @map("downloaded_bytes")
  /// What an unfinished job waits for, for people (e.g. a Telegram rate limit); null otherwise.
  statusDetail        String?        @map("status_detail")
  error               String?
  startedAt           DateTime?      @map("started_at") @db.Timestamptz(3)
  messagesCompletedAt DateTime?      @map("messages_completed_at") @db.Timestamptz(3)
  completedAt         DateTime?      @map("completed_at") @db.Timestamptz(3)
  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  channel      Channel       @relation(fields: [channelId], references: [id], onDelete: Cascade)
  parent       ImportJob?    @relation("ImportJobChildren", fields: [parentImportJobId], references: [id], onDelete: SetNull)
  children     ImportJob[]   @relation("ImportJobChildren")
  downloadJobs DownloadJob[]

  /// At most one PENDING/RUNNING/PAUSED job per channel (idempotent POST /import and /sync).
  /// The predicate is written in PostgreSQL's canonical form so `migrate diff` stays empty.
  @@unique([channelId], map: "import_jobs_one_active_per_channel", where: raw("(status = ANY (ARRAY['PENDING'::\"JobStatus\", 'RUNNING'::\"JobStatus\", 'PAUSED'::\"JobStatus\"]))"))
  @@index([channelId, createdAt(sort: Desc)])
  @@index([status])
  @@index([parentImportJobId])
  @@map("import_jobs")
}

/// The download of one media file. The worker's scheduler hands PENDING rows to BullMQ one try
/// at a time (ACTIVE); failed tries come back as PENDING with a later not_before.
model DownloadJob {
  id          String              @id @default(dbgenerated("uuidv7()")) @db.Uuid
  mediaId     String              @unique @map("media_id") @db.Uuid
  importJobId String?             @map("import_job_id") @db.Uuid
  status      DownloadJobStatus   @default(PENDING)
  /// Incremented whenever the scheduler queues a try; BullMQ job id = dl-<id>-<runSeq>.
  runSeq      Int                 @default(0) @map("run_seq")
  /// Failed tries (waiting for Telegram or for space does not count).
  attempts    Int                 @default(0)
  /// 0–100.
  progress    Int                 @default(0)
  stage       DownloadStage?
  /// Set when someone asked for this file: it goes first and ignores the automatic settings.
  requestedAt DateTime?           @map("requested_at") @db.Timestamptz(3)
  /// The next try waits until then.
  notBefore   DateTime?           @map("not_before") @db.Timestamptz(3)
  reason      DownloadSkipReason?
  error       String?
  /// The channel of the file's message. Filled in by a trigger on insert (a file never moves),
  /// so per-channel counts and the download queue never join media and messages.
  channelId   String?             @map("channel_id") @db.Uuid
  /// The file's size (media.size), kept equal by triggers; orders the queue smallest first.
  size        BigInt?
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  media     Media      @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  importJob ImportJob? @relation(fields: [importJobId], references: [id], onDelete: SetNull)

  @@index([importJobId, status])
  @@index([status, notBefore])
  /// Counts per channel and status (downloads panel, channel stats) from the index alone.
  @@index([channelId, status, size])
  /// The waiting files in the order the worker takes them: asked for first, then smallest.
  @@index([requestedAt, size, id], map: "download_jobs_queue_idx", where: raw("(status = 'PENDING'::\"DownloadJobStatus\")"))
  @@map("download_jobs")
}

// ---------------------------------------------------------------------------
// Telegram backups (copies of archived messages in a Telegram chat of the user's)
// ---------------------------------------------------------------------------

/// The backup copy of one archived message in one backup chat: a NEW message (never a forward)
/// whose file was uploaded again. One row per message and backup chat; the source message's
/// metadata stays in messages/media, this row only describes the copy.
model MessageBackup {
  id                 String            @id @default(dbgenerated("uuidv7()")) @db.Uuid
  messageId          String            @map("message_id") @db.Uuid
  storageLocationId  String            @map("storage_location_id") @db.Uuid
  /// The source message's channel, copied at insert: per-channel counts read one table.
  channelId          String            @map("channel_id") @db.Uuid
  status             BackupStatus      @default(PENDING)
  stage              BackupStage?
  skipReason         BackupSkipReason? @map("skip_reason")
  /// Incremented whenever the worker takes the row; every write checks it (ownership).
  runSeq             Int               @default(0) @map("run_seq")
  /// The worker process running it (host:pid:uuid); a quiet row of another process is taken back.
  owner              String?
  /// Failed tries (waiting for Telegram does not count).
  attempts           Int               @default(0)
  /// The next try waits until then.
  notBefore          DateTime?         @map("not_before") @db.Timestamptz(3)
  /// Set by "Back up now": goes first, even while automatic backup is off.
  requestedAt        DateTime?         @map("requested_at") @db.Timestamptz(3)
  /// "Back up again": send a new copy although one exists.
  force              Boolean           @default(false)
  /// Delete the earlier copies (replaced_message_ids) once the new one is sent.
  replacePrevious    Boolean           @default(false) @map("replace_previous")
  /// The file's size (media.size), for progress; null for text.
  size               BigInt?
  uploadedBytes      BigInt            @default(0) @map("uploaded_bytes")
  /// Telegram random_id of the send, stored before it: repeating the send cannot post twice.
  randomId           BigInt?           @map("random_id")
  /// The file already uploaded to Telegram ({kind, id, accessHash, fileReference}) while the
  /// rest of its album uploads; cleared once sent.
  uploadedMedia      Json?             @map("uploaded_media")
  /// What was sent (file name, size, SHA-256 of the bytes; SHA-256 of the text): after a crash
  /// the backup chat is matched against these, and Verify compares them.
  sentName           String?           @map("sent_name")
  sentSize           BigInt?           @map("sent_size")
  sentSha256         String?           @map("sent_sha256") @db.Char(64)
  sentTextHash       String?           @map("sent_text_hash") @db.Char(64)
  /// The copy: marked chat id, message id, forum topic and album id in the backup chat.
  backupChatId       BigInt?           @map("backup_chat_id")
  backupMessageId    Int?              @map("backup_message_id")
  backupThreadId     Int?              @map("backup_thread_id")
  backupGroupedId    BigInt?           @map("backup_grouped_id")
  /// Follow-up text messages (a caption longer than Telegram allows with a media file).
  extraMessageIds    Int[]             @default([]) @map("extra_message_ids")
  /// Earlier copies, deleted once this one is sent when replace_previous is set.
  replacedMessageIds Int[]             @default([]) @map("replaced_message_ids")
  error              String?
  lastAttemptAt      DateTime?         @map("last_attempt_at") @db.Timestamptz(3)
  completedAt        DateTime?         @map("completed_at") @db.Timestamptz(3)
  /// Outcome of the last Verify; verify_error is null when the copy was found as expected.
  verifiedAt         DateTime?         @map("verified_at") @db.Timestamptz(3)
  verifyError        String?           @map("verify_error")
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  message         Message         @relation(fields: [messageId], references: [id], onDelete: Cascade)
  storageLocation StorageLocation @relation(fields: [storageLocationId], references: [id], onDelete: Restrict)
  channel         Channel         @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([messageId, storageLocationId])
  /// Counts per channel and status (backup panel).
  @@index([channelId, status])
  /// The work of each backup chat.
  @@index([storageLocationId, status])
  @@map("message_backups")
}

/// A forum topic the worker created in a backup chat for one topic of an archived forum.
model BackupTopic {
  id                String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  storageLocationId String   @map("storage_location_id") @db.Uuid
  channelId         String   @map("channel_id") @db.Uuid
  /// The topic in the archived forum (messages.thread_id).
  sourceTopicId     Int      @map("source_topic_id")
  /// The topic in the backup chat.
  backupTopicId     Int      @map("backup_topic_id")
  title             String
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  storageLocation StorageLocation @relation(fields: [storageLocationId], references: [id], onDelete: Cascade)
  channel         Channel         @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([storageLocationId, channelId, sourceTopicId])
  @@index([channelId])
  @@map("backup_topics")
}

model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("app_settings")
}
