// Telegram Archive Manager — PostgreSQL 18 schema (Prisma 7).
//
// Conventions
// - Primary keys: uuid v7 generated by PostgreSQL 18 (`uuidv7()`), so raw SQL inserts get ids too.
// - Telegram ids: chat ids / access hashes / grouped ids / sizes are BIGINT; message ids are INT
//   (MTProto server message ids are int32). The API serializes BIGINT as strings.
// - Every index is declared here (including GIN, trigram and partial indexes) so that
//   `prisma migrate dev` never drops them. Hand-written SQL in migrations is limited to
//   extensions, the `tam_simple` text search configuration and the search_vector trigger.
// - Binary media never lives in PostgreSQL; `media.storage_key` points into object storage.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
  previewFeatures     = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

enum ChatType {
  CHANNEL
  SUPERGROUP
  GROUP
}

enum MessageType {
  TEXT
  PHOTO
  VIDEO
  DOCUMENT
  AUDIO
  VOICE
  ANIMATION
  VIDEO_NOTE
  STICKER
  POLL
  WEBPAGE
  SERVICE
  OTHER
}

enum MediaType {
  PHOTO
  VIDEO
  DOCUMENT
  AUDIO
  VOICE
  ANIMATION
  VIDEO_NOTE
  STICKER
}

enum DownloadStatus {
  PENDING
  DOWNLOADING
  DOWNLOADED
  FAILED
  SKIPPED
  CANCELLED
}

enum DownloadJobStatus {
  PENDING
  ACTIVE
  PAUSED
  COMPLETED
  FAILED
  SKIPPED
  CANCELLED
}

enum JobStatus {
  PENDING
  RUNNING
  PAUSED
  COMPLETED
  FAILED
  CANCELLED
}

enum ImportJobType {
  IMPORT
  SYNC
}

enum ImportMode {
  ALL
  FROM_DATE
}

enum ImportJobPhase {
  HISTORY
  MEDIA
  DONE
}

enum TelegramAuthState {
  LOGGED_OUT
  CODE_SENT
  PASSWORD_REQUIRED
  READY
}

// ---------------------------------------------------------------------------
// Web authentication
// ---------------------------------------------------------------------------

model User {
  id           String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// Stored lower-cased by the application.
  email        String    @unique
  passwordHash String    @map("password_hash")
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions Session[]

  @@map("users")
}

model Session {
  id                String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  /// sha256(token) as lowercase hex; the raw token only ever lives in the cookie.
  tokenHash         String   @unique @map("token_hash") @db.Char(64)
  /// Sliding expiry, extended at most every few minutes.
  expiresAt         DateTime @map("expires_at") @db.Timestamptz(3)
  absoluteExpiresAt DateTime @map("absolute_expires_at") @db.Timestamptz(3)
  lastSeenAt        DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  userAgent         String?  @map("user_agent")
  ip                String?
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// ---------------------------------------------------------------------------
// Telegram account & dialog cache (written by the worker only)
// ---------------------------------------------------------------------------

model TelegramAccount {
  id               String            @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// Single-tenant: one row with accountKey = 'default'.
  accountKey       String            @unique @default("default") @map("account_key")
  telegramUserId   BigInt?           @map("telegram_user_id")
  username         String?
  displayName      String?           @map("display_name")
  /// AES-256-GCM encrypted phone number (worker key).
  phoneEnc         Bytes?            @map("phone_enc")
  phoneMasked      String?           @map("phone_masked")
  authState        TelegramAuthState @default(LOGGED_OUT) @map("auth_state")
  /// AES-256-GCM encrypted phone_code_hash of the pending login.
  phoneCodeHashEnc Bytes?            @map("phone_code_hash_enc")
  codeExpiresAt    DateTime?         @map("code_expires_at") @db.Timestamptz(3)
  nextCodeType     String?           @map("next_code_type")
  lastError        String?           @map("last_error")
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("telegram_accounts")
}

/// Cache of the dialogs the account can access. POST /api/channels copies from here,
/// so clients can never supply title/access_hash/is_protected themselves.
model TelegramDialog {
  id                 String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// Marked id (-100… for channels/supergroups, -id for basic groups).
  telegramChatId     BigInt   @unique @map("telegram_chat_id")
  title              String
  username           String?
  type               ChatType
  accessHash         BigInt?  @map("access_hash")
  isForum            Boolean  @default(false) @map("is_forum")
  isProtected        Boolean  @default(false) @map("is_protected")
  memberCount        Int?     @map("member_count")
  migratedFromChatId BigInt?  @map("migrated_from_chat_id")
  lastSeenAt         DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(3)

  @@map("telegram_dialogs")
}

// ---------------------------------------------------------------------------
// Archive
// ---------------------------------------------------------------------------

model Channel {
  id                  String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  telegramChatId      BigInt    @unique @map("telegram_chat_id")
  title               String
  username            String?
  type                ChatType
  accessHash          BigInt?   @map("access_hash")
  isForum             Boolean   @default(false) @map("is_forum")
  isProtected         Boolean   @default(false) @map("is_protected")
  memberCount         Int?      @map("member_count")
  syncEnabled         Boolean   @default(false) @map("sync_enabled")
  /// Newest message id of the contiguous imported range [backfillCursorId … headMessageId].
  headMessageId       Int?      @map("head_message_id")
  /// Oldest message id of the contiguous imported range (backfill resumes below it).
  backfillCursorId    Int?      @map("backfill_cursor_id")
  backfillComplete    Boolean   @default(false) @map("backfill_complete")
  lastSyncedAt        DateTime? @map("last_synced_at") @db.Timestamptz(3)
  /// Set on a supergroup that was upgraded from a basic group.
  migratedFromChatId  BigInt?   @map("migrated_from_chat_id")
  /// Set on the legacy basic-group row; points at the supergroup row.
  migratedToChannelId String?   @map("migrated_to_channel_id") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  migratedTo   Channel?    @relation("ChannelMigration", fields: [migratedToChannelId], references: [id], onDelete: SetNull)
  migratedFrom Channel[]   @relation("ChannelMigration")
  messages     Message[]
  importJobs   ImportJob[]

  @@index([migratedToChannelId])
  @@map("channels")
}

model Message {
  id                String                   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  channelId         String                   @map("channel_id") @db.Uuid
  telegramMessageId Int                      @map("telegram_message_id")
  type              MessageType
  /// Message text when the message has no media.
  text              String?
  /// Message text when the message has media (MTProto stores both in one field).
  caption           String?
  /// Formatting entities of whichever of text/caption is set.
  entities          Json?
  telegramDate      DateTime                 @map("telegram_date") @db.Timestamptz(3)
  editDate          DateTime?                @map("edit_date") @db.Timestamptz(3)
  replyToMessageId  Int?                     @map("reply_to_message_id")
  /// Album id (grouped_id).
  mediaGroupId      BigInt?                  @map("media_group_id")
  /// Forum topic / thread id.
  threadId          Int?                     @map("thread_id")
  forwardInfo       Json?                    @map("forward_info")
  views             Int?
  /// Original Telegram message info shown in the detail page (post author, forwards, …).
  telegramMeta      Json?                    @map("telegram_meta")
  isFavorite        Boolean                  @default(false) @map("is_favorite")
  favoritedAt       DateTime?                @map("favorited_at") @db.Timestamptz(3)
  /// Maintained by the messages_search_vector_update trigger (see migrations).
  searchVector      Unsupported("tsvector")? @map("search_vector")
  createdAt         DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  channel Channel      @relation(fields: [channelId], references: [id], onDelete: Cascade)
  media   Media[]
  tags    MessageTag[]

  @@unique([channelId, telegramMessageId])
  @@index([channelId, telegramDate(sort: Desc), telegramMessageId(sort: Desc)])
  @@index([telegramDate(sort: Desc), telegramMessageId(sort: Desc)])
  @@index([channelId, mediaGroupId])
  @@index([favoritedAt(sort: Desc)], map: "messages_favorites_idx", where: raw("is_favorite"))
  @@index([searchVector], map: "messages_search_vector_idx", type: Gin)
  @@map("messages")
}

model Media {
  id                   String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  messageId            String         @map("message_id") @db.Uuid
  /// Opaque adapter id `chatId:messageId:fileUniqueId` — never a raw (expiring) file_reference.
  telegramFileId       String         @map("telegram_file_id")
  /// Stable Telegram file identity; used to never download the same file twice.
  telegramFileUniqueId String         @map("telegram_file_unique_id")
  type                 MediaType
  filename             String?
  mimeType             String?        @map("mime_type")
  size                 BigInt?
  width                Int?
  height               Int?
  /// Seconds.
  duration             Float?
  storageKey           String?        @map("storage_key")
  thumbnailKey         String?        @map("thumbnail_key")
  downloadStatus       DownloadStatus @default(PENDING) @map("download_status")
  /// 0–100.
  downloadProgress     Int            @default(0) @map("download_progress")
  downloadedBytes      BigInt         @default(0) @map("downloaded_bytes")
  /// SHA-256 of the stored object (lowercase hex).
  checksum             String?        @db.Char(64)
  error                String?
  createdAt            DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  message     Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  downloadJob DownloadJob?

  @@unique([messageId, telegramFileUniqueId])
  @@index([telegramFileUniqueId])
  @@index([checksum])
  @@index([downloadStatus, type])
  @@index([filename(ops: raw("gin_trgm_ops"))], map: "media_filename_trgm_idx", type: Gin)
  @@map("media")
}

model Tag {
  id             String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name           String
  /// NFC + lower-case form of name; enforces case/Unicode-insensitive uniqueness.
  nameNormalized String   @unique @map("name_normalized")
  /// Hex colour, e.g. #3f51b5.
  color          String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  messages MessageTag[]

  @@map("tags")
}

model MessageTag {
  messageId String   @map("message_id") @db.Uuid
  tagId     String   @map("tag_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([messageId, tagId])
  @@index([tagId])
  @@map("message_tags")
}

// ---------------------------------------------------------------------------
// Jobs (PostgreSQL is the source of truth; BullMQ is transport only)
// ---------------------------------------------------------------------------

model ImportJob {
  id                  String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  channelId           String         @map("channel_id") @db.Uuid
  /// Child jobs import the legacy basic group of a migrated supergroup.
  parentImportJobId   String?        @map("parent_import_job_id") @db.Uuid
  type                ImportJobType  @default(IMPORT)
  mode                ImportMode     @default(ALL)
  fromDate            DateTime?      @map("from_date") @db.Timestamptz(3)
  status              JobStatus      @default(PENDING)
  phase               ImportJobPhase @default(HISTORY)
  /// Incremented on every (re)enqueue; BullMQ job id = ij-<id>-<runSeq>.
  runSeq              Int            @default(0) @map("run_seq")
  bullJobId           String?        @map("bull_job_id")
  totalMessages       Int?           @map("total_messages")
  processedMessages   Int            @default(0) @map("processed_messages")
  // The counters below are a cache recomputed from download_jobs aggregates — never incremented.
  totalMedia          Int            @default(0) @map("total_media")
  downloadedFiles     Int            @default(0) @map("downloaded_files")
  failedFiles         Int            @default(0) @map("failed_files")
  skippedFiles        Int            @default(0) @map("skipped_files")
  totalBytes          BigInt         @default(0) @map("total_bytes")
  downloadedBytes     BigInt         @default(0) @map("downloaded_bytes")
  currentFile         String?        @map("current_file")
  error               String?
  startedAt           DateTime?      @map("started_at") @db.Timestamptz(3)
  messagesCompletedAt DateTime?      @map("messages_completed_at") @db.Timestamptz(3)
  completedAt         DateTime?      @map("completed_at") @db.Timestamptz(3)
  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  channel      Channel       @relation(fields: [channelId], references: [id], onDelete: Cascade)
  parent       ImportJob?    @relation("ImportJobChildren", fields: [parentImportJobId], references: [id], onDelete: SetNull)
  children     ImportJob[]   @relation("ImportJobChildren")
  downloadJobs DownloadJob[]

  /// At most one PENDING/RUNNING/PAUSED job per channel (idempotent POST /import and /sync).
  /// The predicate is written in PostgreSQL's canonical form so `migrate diff` stays empty.
  @@unique([channelId], map: "import_jobs_one_active_per_channel", where: raw("(status = ANY (ARRAY['PENDING'::\"JobStatus\", 'RUNNING'::\"JobStatus\", 'PAUSED'::\"JobStatus\"]))"))
  @@index([channelId, createdAt(sort: Desc)])
  @@index([status])
  @@index([parentImportJobId])
  @@map("import_jobs")
}

model DownloadJob {
  id          String            @id @default(dbgenerated("uuidv7()")) @db.Uuid
  mediaId     String            @unique @map("media_id") @db.Uuid
  importJobId String?           @map("import_job_id") @db.Uuid
  status      DownloadJobStatus @default(PENDING)
  attempts    Int               @default(0)
  /// 0–100.
  progress    Int               @default(0)
  error       String?
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  media     Media      @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  importJob ImportJob? @relation(fields: [importJobId], references: [id], onDelete: SetNull)

  @@index([importJobId, status])
  @@index([status])
  @@map("download_jobs")
}

model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("app_settings")
}
