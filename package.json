{
  "name": "telegram-archive-manager",
  "version": "0.1.0",
  "private": true,
  "description": "Unofficial Telegram Archive Manager — archive and browse the Telegram channels/groups your account can access.",
  "type": "module",
  "workspaces": [
    "packages/shared",
    "packages/crypto",
    "packages/database",
    "packages/storage",
    "packages/telegram",
    "apps/api",
    "apps/worker",
    "apps/web",
    "apps/e2e"
  ],
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": ">=11.0.0",
      "onFail": "warn"
    }
  },
  "scripts": {
    "db:generate": "npm run generate -w @tam/database",
    "db:migrate": "npm run migrate:dev -w @tam/database --",
    "db:deploy": "npm run migrate:deploy -w @tam/database",
    "db:check": "npm run migrate:check -w @tam/database",
    "db:recreate": "npm run recreate -w @tam/database --",
    "build:packages": "npm run db:generate && tsc -b packages/shared packages/crypto packages/database packages/storage packages/telegram",
    "build": "npm run build:packages && npm run build -w @tam/api -w @tam/worker -w @tam/web",
    "typecheck": "npm run build:packages && npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "test": "npm run build:packages && npm run test --workspaces --if-present",
    "test:integration": "npm run build:packages && npm run test:integration --workspaces --if-present",
    "dev": "npm run build:packages && tsc -b apps/api apps/worker && concurrently -k -n tsc,api,worker,web -c gray,blue,magenta,green \"tsc -b -w --preserveWatchOutput apps/api apps/worker\" \"npm run dev:run -w @tam/api\" \"npm run dev:run -w @tam/worker\" \"npm run start -w @tam/web\"",
    "prod:start": "node scripts/prod/pm2.mjs start",
    "prod:stop": "node scripts/prod/pm2.mjs stop",
    "prod:restart": "node scripts/prod/pm2.mjs restart",
    "prod:status": "node scripts/prod/pm2.mjs status",
    "prod:logs": "node scripts/prod/pm2.mjs logs",
    "prod:update": "node scripts/prod/pm2.mjs update",
    "prod:enable": "node scripts/prod/pm2.mjs enable",
    "prod:disable": "node scripts/prod/pm2.mjs disable",
    "user:create": "npm run user:create -w @tam/api --",
    "user:reset-password": "npm run user:reset-password -w @tam/api --",
    "test:e2e": "npm run e2e -w @tam/e2e",
    "test:e2e:full": "npm run build && npm run test:e2e",
    "test:coverage": "npm run build:packages && node scripts/coverage.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "~24.13.6",
    "@vitest/coverage-v8": "4.1.11",
    "angular-eslint": "~22.5.0",
    "concurrently": "^10.0.5",
    "eslint": "~10.11.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "~8.70.1",
    "vitest": "~4.1.11"
  },
  "overrides": {
    "typescript": "$typescript",
    "vitest": "$vitest",
    "prisma": "7.10.0",
    "@prisma/client": "7.10.0",
    "deepmerge-ts": "^8.0.2",
    "mysql2": "^3.24.4"
  },
  "allowScripts": {
    "argon2@0.45.1": true,
    "esbuild@0.28.2": true,
    "lmdb@3.5.6": true,
    "msgpackr-extract@3.0.4": true,
    "@parcel/watcher@2.6.0": true,
    "@prisma/engines@7.10.0": true,
    "@swc/core@1.16.2": true,
    "prisma@7.10.0": true,
    "better-sqlite3": false
  }
}
