{
  "name": "@tam/api",
  "version": "0.0.0",
  "private": true,
  "description": "NestJS REST + SSE API for the archive manager.",
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "start": "node dist/main.js",
    "dev:run": "node --watch dist/main.js",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.e2e.config.ts",
    "user:create": "node dist/cli/create-user.js"
  },
  "dependencies": {
    "@nestjs/bullmq": "12.0.0",
    "@nestjs/common": "12.1.0",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.1.0",
    "@nestjs/platform-express": "12.1.0",
    "@nestjs/terminus": "12.1.0",
    "@nestjs/throttler": "6.7.0",
    "@tam/crypto": "0.0.0",
    "@tam/database": "0.0.0",
    "@tam/shared": "0.0.0",
    "@tam/storage": "0.0.0",
    "argon2": "0.45.1",
    "bullmq": "6.3.8",
    "ioredis": "5.11.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@nestjs/testing": "12.1.0",
    "@swc/core": "1.16.2",
    "@types/express": "5.0.6",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.0",
    "unplugin-swc": "2.0.0"
  }
}
