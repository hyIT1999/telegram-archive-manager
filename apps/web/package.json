{
  "name": "@tam/web",
  "version": "0.0.0",
  "private": true,
  "description": "Angular admin UI (Digital Learning Archive).",
  "type": "module",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "typecheck": "ngc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit",
    "lint": "ng lint",
    "test": "ng test --watch=false"
  },
  "dependencies": {
    "@angular/cdk": "~22.2.0",
    "@angular/common": "~22.2.0",
    "@angular/compiler": "~22.2.0",
    "@angular/core": "~22.2.0",
    "@angular/forms": "~22.2.0",
    "@angular/material": "~22.2.0",
    "@angular/platform-browser": "~22.2.0",
    "@angular/router": "~22.2.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/source-serif-4": "5.3.0",
    "@tam/shared": "0.0.0",
    "material-symbols": "0.47.5",
    "rxjs": "7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "~22.1.8",
    "@angular/cli": "~22.1.8",
    "@angular/compiler-cli": "~22.2.0",
    "jsdom": "30.1.1"
  }
}
