{
  "name": "@tam/worker",
  "version": "0.0.0",
  "private": true,
  "description": "BullMQ worker process: owns the single Telegram connection, imports history and downloads media.",
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "start": "node dist/main.js",
    "dev:run": "node --watch dist/main.js",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@nestjs/bullmq": "12.0.0",
    "@nestjs/common": "12.1.0",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.1.0",
    "@tam/crypto": "0.0.0",
    "@tam/database": "0.0.0",
    "@tam/shared": "0.0.0",
    "@tam/storage": "0.0.0",
    "@tam/telegram": "0.0.0",
    "bullmq": "6.3.8",
    "ioredis": "5.11.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@nestjs/testing": "12.1.0",
    "@swc/core": "1.16.2",
    "unplugin-swc": "2.0.0"
  }
}
