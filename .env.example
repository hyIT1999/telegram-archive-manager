# =============================================================================
# Unofficial Telegram Archive Manager — environment variables
# Copy to `.env` (repository root) and fill in. `.env` is gitignored: never commit secrets.
# =============================================================================

# ---- Common -----------------------------------------------------------------
NODE_ENV=development
# debug | info | warn | error
LOG_LEVEL=info

# PostgreSQL 18 — application database (Prisma)
DATABASE_URL=postgresql://tam:CHANGE_ME@localhost:5432/tam
# Only for `prisma migrate dev/diff` (empty database the role owns)
SHADOW_DATABASE_URL=postgresql://tam:CHANGE_ME@localhost:5432/tam_shadow

# Redis 7 — BullMQ queues, Telegram RPC, locks, sign-in lockouts. Use a password.
REDIS_URL=redis://:CHANGE_ME@127.0.0.1:6380/0
BULLMQ_PREFIX=tam

# ---- API (apps/api) -----------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=3100
# true behind HTTPS; false only for plain-HTTP local/LAN use (the browser drops Secure cookies on http)
COOKIE_SECURE=false
# Sliding session lifetime and hard maximum
SESSION_TTL_HOURS=168
SESSION_ABSOLUTE_TTL_DAYS=30
# Comma-separated origins allowed to POST (checked when Sec-Fetch-Site is unavailable). Their host
# names are also names the api answers for.
CSRF_TRUSTED_ORIGINS=http://localhost:4300
# More host names the api answers for, comma-separated (e.g. archive.lan,*.example.com). IP
# addresses and localhost always work; any other Host header gets 421 (DNS rebinding guard).
ALLOWED_HOSTS=
# Express "trust proxy" setting: false without a proxy, 1 behind exactly one (nginx in Docker)
TRUST_PROXY=loopback
# The built web app, served by the api itself (production with pm2: ecosystem.config.cjs sets it).
# Leave empty in development (ng serve) and in Docker (nginx serves it).
WEB_DIST_DIR=
# How long a Telegram action (login step, chat list refresh) waits for the worker (500–120000)
TELEGRAM_RPC_TIMEOUT_MS=30000

# ---- Worker (apps/worker) — Telegram credentials live ONLY here -----------------
# Create your own app at https://my.telegram.org → API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Separate database for the Telegram session (never touched by Prisma or tests)
TELEGRAM_SESSION_DATABASE_URL=postgresql://tam:CHANGE_ME@localhost:5432/tam_tg
# 32 random bytes, base64 — encrypts the Telegram auth key and login state at rest.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TELEGRAM_SESSION_KEY=
# How often the worker refreshes its liveness key in Redis (1000–60000; TTL = 3 × interval)
WORKER_HEARTBEAT_INTERVAL_MS=5000
# File touched after every heartbeat, for a container healthcheck (the Docker image sets it)
WORKER_ALIVE_FILE=
# Pause between two pages of history (100 messages) during imports, in ms (0–60000).
# Keeps well clear of Telegram's rate limits; lower it only for small, quick imports.
IMPORT_PAGE_DELAY_MS=1000

# ---- Storage locations (where archived media is saved; README section 9) ------------
# api AND worker read this section: the api manages the locations, the worker downloads into them.
# Folder of the built-in "This computer" location. Use an ABSOLUTE path: api and worker run from
# different working directories.
STORAGE_LOCAL_ROOT=/absolute/path/to/tam-storage
# Folders, separated by ";", inside which the web may add more "folder on this computer"
# locations (e.g. D:\Telegram;E:\Backup). Defaults to STORAGE_LOCAL_ROOT. The web can never write
# anywhere else.
STORAGE_LOCAL_ROOTS=
# 32 random bytes, base64 — encrypts Google Drive credentials at rest. Needed for Google Drive.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
STORAGE_SECRET_KEY=
# Google Drive: OAuth client of type "TVs and Limited Input devices" from console.cloud.google.com
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Downloads to a folder on this server wait while its disk would have less free space than this
MIN_FREE_DISK_MB=2048
# Where files for Google Drive wait before the upload (needs room for the largest file, ~2-4 GB).
# Default: <STORAGE_LOCAL_ROOT>/.tam-tmp. Worker only.
DOWNLOAD_STAGING_DIR=
# Small previews Telegram keeps of each file (a few tens of KB each).
# Default: <STORAGE_LOCAL_ROOT>/.tam-thumbnails. Set it the same for api and worker.
THUMBNAIL_DIR=
# Telegram backup chats (README section 9, "Sao lưu sang Telegram") need no settings here: the
# worker posts the copies with the Telegram account signed in above, into a chat you choose on
# the web. Files stream through memory (from Telegram, or from a downloaded copy); nothing is
# written to disk.
# S3-compatible object storage — planned, not used yet. Server-side only.
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# ---- Docker Compose only --------------------------------------------------------
# Hex strings (openssl rand -hex 24): they end up inside connection URLs.
# The archive's own database role (not a superuser), used in every connection URL
POSTGRES_PASSWORD=CHANGE_ME
# PostgreSQL's superuser; only used when the database volume is first created
POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME
# The addresses you open the archive with, comma-separated, e.g.
# http://192.168.1.20:8080,http://nas.lan:8080 — host names must be listed here or in ALLOWED_HOSTS
WEB_ORIGINS=http://localhost:8080
# Host port published by the web (nginx) container
WEB_PORT=8080
# The first web user is created with the CLI (it asks for the password without showing it):
#   docker compose exec api node apps/api/dist/cli/create-user.js --email you@example.com
